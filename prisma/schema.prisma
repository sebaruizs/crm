generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  role           String
  color          String
  avatarInitials String
  createdAt      DateTime @default(now())

  contacts      Contact[]      @relation("AssignedAgent")
  notes         Note[]
  notifications Notification[]
  sessions      Session[]
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?           // user that performed the action (null for anon/failed login)
  actorName  String?           // denormalized for display when actor is deleted
  action     String            // e.g. "login.success", "user.create", "settings.update"
  targetType String?           // "user", "contact", "tag", etc.
  targetId   String?
  metadata   String   @default("{}") // arbitrary JSON context
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([expiresAt])
}

model Contact {
  id               String    @id @default(cuid())
  name             String
  phone            String
  source           String
  status           String
  assignedAgentId  String?
  assignedAgent    User?     @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  tagIds           String    @default("[]")
  whatsAppStatus   String    @default("connected")
  createdAt        DateTime  @default(now())
  lastMessageAt    DateTime  @default(now())
  vehicleInterest  String?
  licenseVerified  Boolean   @default(false)
  visitScheduledAt DateTime?
  lineId           String?
  customFields     String    @default("[]")

  // Click-to-WhatsApp ad metadata (populated when contact came via a Facebook/Instagram ad)
  adId          String?
  adHeadline    String?
  adSourceUrl   String?
  adPlatform    String?  // "facebook" | "instagram"
  adCtwaClid    String?  // click-to-WhatsApp click ID (for Meta attribution)

  // Chatbot flow state: -1 = not in bot, 0..N = waiting answer to question N, "done" = handed off
  chatbotState  String   @default("idle") // "idle" | "asking" | "done"
  chatbotStep   Int      @default(0)
  chatbotAnswers String  @default("{}") // JSON key→value of answers

  messages      Message[]
  notes         Note[]
  notifications Notification[]

  @@index([phone])
  @@index([status])
  @@index([assignedAgentId])
  @@index([lastMessageAt])
  @@index([source])
}

model Message {
  id          String   @id @default(cuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  direction   String
  body        String
  sentAt      DateTime
  status      String
  // Optional media attached to the message
  mediaType   String?  // "image" | "video" | "audio" | "document"
  mediaUrl    String?  // public URL to the file (served via /api/files/:id)
  mediaName   String?  // original filename for documents
  mediaMime   String?  // MIME type

  @@index([contactId])
  @@index([sentAt])
}

model Note {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([contactId])
}

model Template {
  id        String   @id @default(cuid())
  label     String
  body      String
  shortcut  String?
  createdAt DateTime @default(now())
}

model Settings {
  id                 Int     @id @default(1)
  welcomeEnabled     Boolean @default(false)
  welcomeTemplateId  String?
  inactivityHours    Int     @default(4)
  autoAssignEnabled  Boolean @default(false)
  autoAssignStrategy String  @default("least_busy")
  autoAssignRoles    String  @default("[\"agente\"]")
  // Chatbot de calificación
  chatbotEnabled   Boolean @default(false)
  chatbotQuestions String  @default("[]") // JSON [{key, text, type, options?}]
  chatbotClosing   String  @default("¡Gracias! Un agente te va a atender en breve. 🙌")
}

model Notification {
  id              String    @id @default(cuid())
  recipientUserId String
  recipient       User      @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            String
  contactId       String
  contact         Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactName     String
  body            String
  createdAt       DateTime  @default(now())
  readAt          DateTime?

  @@index([recipientUserId])
  @@index([readAt])
  @@index([createdAt])
}

model Line {
  id          String    @id
  name        String
  agentId     String?
  provider    String    @default("baileys") // "baileys" | "meta"
  status      String    @default("disconnected")
  phoneNumber String?
  lastError   String?
  connectedAt DateTime?
  createdAt   DateTime  @default(now())

  // Meta Cloud API specific (only set when provider="meta")
  phoneNumberId String?
  accessToken   String?
  verifyToken   String?
  wabaId        String?
}

model Tag {
  id        String   @id @default(cuid())
  label     String
  color     String   // Tailwind class e.g. "bg-blue-100 text-blue-700"
  createdAt DateTime @default(now())
}

model PipelineStage {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  color     String   // Tailwind class for the column header e.g. "border-blue-400 bg-blue-50"
  position  Int      @default(0)
  kind      String   @default("active") // "pending" | "active" | "won" | "lost"
  createdAt DateTime @default(now())

  @@index([position])
}

model CustomFieldDef {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  type      String   // "text" | "number" | "date" | "select"
  options   String   @default("[]") // JSON array of strings (for type=select)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([position])
}
